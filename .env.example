# ==============================================================================
# REACT-X — AI Satellite Thermal Intelligence & Industrial Fire Command Platform
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` in your deployment environment and adjust values.
# NEVER commit sensitive production credentials or .env files into version control.
#
# CONFIGURATION CLASSIFICATIONS:
#   [REAL / LIVE]   Mandatory or active in production environments
#   [REFERENCE]     Reference facility identifiers and baselines (e.g. Hazira)
#   [SIMULATION]    Controls synthetic event generation & chaos testing
#   [OPTIONAL]      Optional satellite credentials; falls back to public STAC catalogs
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM & ENVIRONMENT [REAL / LIVE]
# ------------------------------------------------------------------------------
# Environment mode: production | development | reference | simulation
# In 'production' mode, strict startup checks enforce PostgreSQL and explicit CORS.
APP_ENV=production

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Request timeout in seconds
REQUEST_TIMEOUT_SEC=30.0

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION [REAL / LIVE]
# ------------------------------------------------------------------------------
# PostgreSQL 16+ with PostGIS 3.4+ connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Development/Edge fallback: sqlite:///./sih1505.db (Prohibited when APP_ENV=production)
DATABASE_URL=postgresql://reactx_admin:CHANGE_ME_SECURE_PASSWORD@postgres:5432/reactx_thermal

# PostgreSQL Service Container Credentials (Used by docker-compose)
POSTGRES_DB=reactx_thermal
POSTGRES_USER=reactx_admin
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_PORT=5432

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 3. NASA FIRMS INGESTION [REAL / LIVE]
# ------------------------------------------------------------------------------
# NASA FIRMS 32-character Map Key.
# Obtain a free live MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=YOUR_32_CHAR_NASA_FIRMS_MAP_KEY_HERE
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv

# Ingestion Polling Interval in minutes (Default: 15, NASA FIRMS rate limit compliant)
FIRMS_POLL_INTERVAL_MINUTES=15
FIRMS_TIMEOUT_SEC=15.0
FIRMS_MAX_RETRIES=3
FIRMS_LOOKBACK_DAYS=1

# India-scale Default Bounding Box [lon_min, lat_min, lon_max, lat_max]
FIRMS_DEFAULT_BBOX=68.0,8.0,97.0,37.5

# Active Satellite Constellations polled from FIRMS
FIRMS_SOURCE_CONSTELLATIONS=VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,VIIRS_SNPP_NRT,MODIS_NRT

# Dedicated Ingestion Worker Guard:
# MUST be 'false' for API web workers to prevent duplicate polling.
# MUST be 'true' ONLY for the dedicated background worker container.
ENABLE_BACKGROUND_POLL=false

# ------------------------------------------------------------------------------
# 4. SATELLITE OPEN STAC & CONTEXT ENDPOINTS [REAL / LIVE - ZERO AUTH REQUIRED]
# ------------------------------------------------------------------------------
# Public STAC catalogs utilized out-of-the-box with zero credentials required
AWS_EARTH_SEARCH_STAC_URL=https://earth-search.aws.element84.com/v1
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# ------------------------------------------------------------------------------
# 5. AUTHENTICATED SATELLITE PROVIDERS [OPTIONAL]
# ------------------------------------------------------------------------------
# If omitted, REACT-X automatically falls back to AWS Earth Search & Planetary Computer STAC.

# Copernicus Data Space Ecosystem (CDSE) / Sentinel Hub
# Register at: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_SH_BASE_URL=https://sh.dataspace.copernicus.eu
COPERNICUS_TIMEOUT_SEC=15.0
COPERNICUS_MAX_CLOUD_PCT=40.0

# USGS Machine-to-Machine (M2M) API — Landsat 8/9 TIRS Level-2
# Register at: https://ers.cr.usgs.gov/
USGS_M2M_USERNAME=
USGS_M2M_TOKEN=
USGS_M2M_BASE_URL=https://m2m.cr.usgs.gov/api/api/json/stable
USGS_M2M_DATASET_NAME=landsat_ot_c2_l2
USGS_M2M_TIMEOUT_SEC=15.0
USGS_M2M_MAX_CLOUD_PCT=50.0

# Earth Observation Group (EOG) — VIIRS Nightfire (VNF)
# Native physical Planck blackbody estimator is built-in by default.
# Academic portal: https://eogdata.mines.edu/products/register/
EOG_VNF_USERNAME=
EOG_VNF_PASSWORD=
EOG_VNF_CLIENT_ID=eogdata_oidc
EOG_VNF_CLIENT_SECRET=
EOG_VNF_TOKEN_URL=https://eogauth.mines.edu/realms/eog/protocol/openid-connect/token
EOG_VNF_BASE_URL=https://eogdata.mines.edu/wwwdata/viirs_products/vnf/v40
EOG_VNF_TIMEOUT_SEC=20.0

# ------------------------------------------------------------------------------
# 6. ML & INTELLIGENCE ENGINE CONFIGURATION [REAL / LIVE - FROZEN]
# ------------------------------------------------------------------------------
# Frozen ML Decision Boundaries & Quality Thresholds
ML_ABSTENTION_THRESHOLD=0.45
DATA_QUALITY_MIN_COVERAGE=0.60

# ------------------------------------------------------------------------------
# 7. SECURITY & ACCESS CONTROL [REAL / LIVE]
# ------------------------------------------------------------------------------
# CORS Allowed Origins: comma-separated list of explicit enterprise/command origins.
# Wildcard '*' is strictly prohibited when APP_ENV=production.
CORS_ORIGINS=https://reactx.industry.gov.in,https://command.hazira.internal,http://localhost:5173,http://localhost:80

# ------------------------------------------------------------------------------
# 8. INDUSTRIAL SAFETY BOUNDARY [REAL / LIVE - READ ONLY ENFORCED]
# ------------------------------------------------------------------------------
# Industrial IoT / SCADA Integration Protocols (OPC-UA, Modbus TCP, MQTT)
# REACT-X is strictly READ-ONLY. No write paths to PLC, DCS, SIS, or ESD exist.
TELEMETRY_POLL_INTERVAL_SEC=5.0
TELEMETRY_STALE_THRESHOLD_SEC=30.0

# ------------------------------------------------------------------------------
# 9. REFERENCE INFRASTRUCTURE [REFERENCE]
# ------------------------------------------------------------------------------
# Default reference plant configuration (Hazira Petrochemical Complex, Gujarat)
REFERENCE_FACILITY_ID=FAC-IND-GUJ-HAZ-001
REFERENCE_FACILITY_NAME=Hazira Petrochemical Complex
REFERENCE_STATE=Gujarat
REFERENCE_LAT=21.1685
REFERENCE_LON=72.6958

# ------------------------------------------------------------------------------
# 10. SIMULATION & TESTING [SIMULATION]
# ------------------------------------------------------------------------------
# Set to 'true' only in testing/chaos simulation environments.
ENABLE_CHAOS_INJECTION=false
SIMULATION_ANOMALY_RATE=0.0
