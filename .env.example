# SIH26162 — REACT-X Thermal Intelligence Platform
# Environment Configuration Template
# Copy this file to .env and set your values.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────
# NASA FIRMS — Satellite Data Ingestion
# ─────────────────────────────────────────────
# Required for live satellite data. Get your key at:
# https://firms.modaps.eosdis.nasa.gov/usfs/api/area/csv/
NASA_FIRMS_MAP_KEY=b5bbb3c25ec3a75f9e9226a75efb4cc9

# FIRMS API base URL (defaults to NRT CSV endpoint)
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv

# Default bounding box for India [lon_min,lat_min,lon_max,lat_max]
FIRMS_DEFAULT_BBOX=68.0,8.0,97.0,37.5

# FIRMS polling interval in minutes (min: 10, recommended: 15)
FIRMS_POLL_INTERVAL_MINUTES=15

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# Development (default, no setup required):
DATABASE_URL=sqlite:///./sih1505.db

# Production (PostgreSQL + PostGIS):
# DATABASE_URL=postgresql://sih26162:STRONG_PASSWORD@localhost:5432/sih26162_thermal

# ─────────────────────────────────────────────
# AI/ML Configuration
# ─────────────────────────────────────────────
ML_ABSTENTION_THRESHOLD=0.45

# ─────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────
# CORS — comma-separated list of allowed origins (NO wildcard * in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ─────────────────────────────────────────────
# PostgreSQL (only needed with production profile)
# ─────────────────────────────────────────────
# DB_USER=sih26162
# DB_PASSWORD=STRONG_RANDOM_PASSWORD_HERE
